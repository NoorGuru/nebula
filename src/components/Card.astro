---
interface Props {
  slug: string;
  title: string;
  summary: string;
  summaryAr?: string;
  tags?: string[];
  featured?: boolean;
  date?: string;
  sector?: string;
  stage?: string;
  amountRaised?: string;
  valuation?: string;
  status?: string;
  coreProblem?: string;
  whyItWorked?: string;
  country?: string;
  index?: number;
}

const {
  slug,
  title,
  summary,
  summaryAr,
  tags = [],
  featured = false,
  date,
  sector,
  stage,
  amountRaised,
  valuation,
  status = 'operating',
  coreProblem,
  whyItWorked,
  country = 'Egypt',
  index = 0,
} = Astro.props;

// Single uniform radius comes from .card in global.css (grid rhythm);
// asymmetry lives on kickers/badges only.
const isFailure = status === 'closed' || status === 'failed' || tags.includes('failure');
const isUnicorn = tags.includes('unicorn');
const isIdea = status === 'idea';
const isFrontier = tags.includes('frontier');
const statusClass = isFailure
  ? 'card--failure'
  : isUnicorn
    ? 'card--unicorn'
    : isIdea
      ? 'card--idea'
      : 'card--operating';

const eyebrow = [country, date].filter(Boolean).join(' · ');

// Full playbook still travels on Copy — the card surface itself stays summary-only.
const copyText = `${title}\n\nSummary: ${summary}\n\nعربي: ${summaryAr || ''}\n\nThe Move: ${whyItWorked || coreProblem || ''}`;
---

<div
  class={`card ${statusClass} ${featured ? 'card-featured' : ''}`}
  data-sector={sector ? sector.toLowerCase() : ''}
  data-status={isFailure ? 'failure' : isUnicorn ? 'unicorn' : isIdea ? 'idea' : 'operating'}
  data-frontier={isFrontier ? 'true' : 'false'}
>
  <!-- Card Header Row -->
  <div class="card-header-row">
    <span class="card-header-badges">
      <span class={`card-badge-status ${isFailure ? 'card-badge-status--failure' : isUnicorn ? 'card-badge-status--unicorn' : isIdea ? 'card-badge-status--idea' : 'card-badge-status--operating'}`}>
        {isFailure ? '💥 Failed' : isUnicorn ? '🦄 Unicorn' : isIdea ? '🌱 Idea' : `⚡️ ${stage ? stage.toUpperCase() : 'OPERATING'}`}
      </span>
      {isFrontier && (
        <span class="card-badge-status card-badge-status--frontier">✦ Frontier</span>
      )}
    </span>

    {valuation && valuation !== 'MISSING' ? (
      <span class="card-kpi-pill" title={`Val: ${valuation}`}>
        Val: {valuation}
      </span>
    ) : amountRaised ? (
      <span class="card-kpi-pill" title={amountRaised}>
        {amountRaised}
      </span>
    ) : null}
  </div>

  <!-- Eyebrow: locale + date -->
  {eyebrow && (
    <p class="card-eyebrow">{eyebrow}</p>
  )}

  <!-- English Title & Summary (stretched: whole card clicks through) -->
  <a href={`/idea/${slug}`} rel="prefetch" class="card-stretched-link" style="text-decoration: none; color: inherit; display: flex; flex-direction: column; gap: var(--space-2);">
    <h2>{title}</h2>
    <p class="card-summary">{summary}</p>
  </a>

  <!-- Arabic Summary (shown in Dual, hidden in EN) -->
  {summaryAr && (
    <div class="card-arabic-box" dir="rtl" lang="ar">
      <span class="card-arabic-kicker">بالعربي</span>
      <p>{summaryAr}</p>
    </div>
  )}

  <!-- Tags Ribbon: sector + one tag max (density; full list on detail) -->
  <ul class="chips" aria-label="Tags">
    {sector && (
      <li><span class="chip chip-sector">{sector}</span></li>
    )}
    {tags.slice(0, 1).map((tag) => (
      <li><span class="chip">#{tag}</span></li>
    ))}
  </ul>

  <!-- Card Action Bar: 1-Click Copy left, Read Story right (thumb side) -->
  <div class="card-action-bar">
    <button
      class="btn-copy-spark"
      type="button"
      data-copy={copyText}
      onclick="navigator.clipboard.writeText(this.getAttribute('data-copy')).then(() => window.showSparkToast && window.showSparkToast('Playbook copied! Go build.'))"
      title="Copy spark playbook to clipboard"
    >
      <span>📋</span>
      <span>Copy</span>
    </button>

    <a href={`/idea/${slug}`} rel="prefetch" class="card-read-link" style="text-decoration: none;">
      Read Story <span aria-hidden="true">➔</span>
    </a>
  </div>
</div>
